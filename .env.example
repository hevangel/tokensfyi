# Safe local-development example values only. Copy to .env; never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_DEBUG=1
SECRET_KEY=replace-with-a-local-random-value
DATABASE_URL=postgresql://token_budget:token_budget@localhost:5432/token_budget
ALLOWED_HOSTS=localhost,127.0.0.1
SECURE_COOKIES=0
POSTGRES_DB=token_budget
POSTGRES_USER=token_budget
POSTGRES_PASSWORD=replace-with-a-local-password
MINIO_ROOT_USER=local-minio-user
MINIO_ROOT_PASSWORD=replace-with-a-local-password
MAILPIT_HOST=localhost
CLAMAV_HOST=clamav
